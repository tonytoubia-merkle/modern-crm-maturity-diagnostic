# ============================================================
# Modern CRM Maturity Diagnostic — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# Get these from: https://app.supabase.com → Project Settings → API
# ------------------------------------------------------------

# Your Supabase project URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your Supabase service role key (KEEP SECRET — server-side only)
# Get from: Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# ADMIN DASHBOARD
# Admin access is role-based via the app_users table (migration 005).
# Promote a user with: UPDATE app_users SET role = 'super_admin'
#                      WHERE email = 'someone@merkle.com';
# (or INSERT ... ON CONFLICT DO UPDATE if they've never signed in).
# ------------------------------------------------------------

# ------------------------------------------------------------
# APP URL (used for absolute URLs in PDF/share features)
# Set to your Vercel deployment URL in production
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# EMAIL — Cannes kiosk results follow-up
# Powers POST /api/exec/send-results. If EXEC_FROM_EMAIL (or the provider's
# key) is unset, the kiosk still captures the lead and simply skips the email.
#
# Provider switch (no code change): "resend" (default, Vercel) | "ses" (AWS).
# ------------------------------------------------------------
EMAIL_PROVIDER=resend

# The verified From address; display name supported. Used by both providers.
# "Merkle Modern CRM <no-reply@yourdomain.com>"
EXEC_FROM_EMAIL=Merkle Modern CRM <no-reply@yourdomain.com>

# --- Resend (EMAIL_PROVIDER=resend) ---
#   1. Create a Resend account → API key: https://resend.com/api-keys
#   2. Verify a sending domain (e.g. merkle.com): https://resend.com/domains
#      (for quick testing, "onboarding@resend.dev" only sends to your own
#       account email)
RESEND_API_KEY=re_...

# --- Amazon SES (EMAIL_PROVIDER=ses) ---
# Verify the sending domain (DKIM) in SES and request production access to
# leave the sandbox. On App Runner/ECS, AWS credentials come from the
# instance/task IAM role (grant ses:SendEmail) — do NOT put access keys here.
# Only the region is needed in env:
AWS_REGION=us-east-1
