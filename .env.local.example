# ============================================================
# Modern CRM Maturity Diagnostic — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# Get these from: https://app.supabase.com → Project Settings → API
# ------------------------------------------------------------

# Your Supabase project URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your Supabase service role key (KEEP SECRET — server-side only)
# Get from: Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# ADMIN DASHBOARD
# Admin access is role-based via the app_users table (migration 005).
# Promote a user with: UPDATE app_users SET role = 'super_admin'
#                      WHERE email = 'someone@merkle.com';
# (or INSERT ... ON CONFLICT DO UPDATE if they've never signed in).
# ------------------------------------------------------------

# ------------------------------------------------------------
# APP URL (used for absolute URLs in PDF/share features)
# Set to your Vercel deployment URL in production
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# EMAIL — Cannes kiosk results follow-up (Resend)
# Powers POST /api/exec/send-results. Both are optional: if either is
# unset the kiosk still captures the lead and simply skips the email.
#   1. Create a Resend account → API key: https://resend.com/api-keys
#   2. Verify a sending domain (e.g. merkle.com): https://resend.com/domains
#      (for quick testing, "onboarding@resend.dev" only sends to your own
#       account email)
# ------------------------------------------------------------
RESEND_API_KEY=re_...
# The verified From address; display name supported, e.g.
# "Merkle Modern CRM <no-reply@yourdomain.com>"
EXEC_FROM_EMAIL=Merkle Modern CRM <no-reply@yourdomain.com>

# ------------------------------------------------------------
# CAPTURE — leads to your inbox, where a standard (non-premium) flow takes over
# Powers POST /api/exec/capture. The kiosk saves to Supabase (source of truth)
# AND emails a structured capture message — subject "[Cannes Capture] <email>",
# plain text with a fenced ---DATA-JSON--- / ---END-JSON--- block carrying the
# attendee email + results — to the inbox below.
#
# Sender: Resend's shared onboarding@resend.dev (set as default in code), which
# needs NO verified domain because it only delivers to the Resend account's own
# signup address. ==> EXEC_CAPTURE_EMAIL MUST equal your Resend signup email,
# and that mailbox must be the M365/Outlook inbox your flow watches.
#
# A standard Power Automate flow then:
#   "When a new email arrives (V3)"  (filter Subject contains "[Cannes Capture]")
#     → parse the JSON block
#     → "Send an email (V2)" from Outlook  (the attendee email, from a person)
#     → (optional) "Create item" in a SharePoint List
# All standard connectors — no premium, no Entra app, no DNS. Unset = no-op.
# ------------------------------------------------------------
EXEC_CAPTURE_EMAIL=tony.toubia@merkle.com
# Optional: override the capture sender once a real domain is verified in
# Resend. Leave unset to use onboarding@resend.dev (no verified domain needed).
# EXEC_CAPTURE_FROM=Merkle Modern CRM <no-reply@cannes.merkle.com>
